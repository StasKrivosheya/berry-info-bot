# Generic env template.
# Prefer `.env.local` for local Python runs and `.env.docker` for docker-compose.

APP_NAME=berry-info-bot
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
ADMIN_USER_IDS=123456789
# Debug commands are not registered when disabled.
DEBUG_COMMANDS_MODE=disabled

# Required only for KB sync/search and future RAG handlers.
OPENAI_API_KEY=
OPENAI_QUERY_ROUTER_MODEL=
OPENAI_QUERY_ROUTER_TIMEOUT_SECONDS=10
OPENAI_VECTOR_STORE_ID=
OPENAI_KB_SEARCH_MAX_RESULTS=3
OPENAI_KB_SCORE_THRESHOLD=0.7
KB_LEXICAL_INDEX_PATH=data/knowledge_base/processed/kb_lexical.sqlite3
QUERY_CONTEXT_TTL_SECONDS=900
