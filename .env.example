# Generic env template.
# Prefer `.env.local` for local Python runs and `.env.docker` for docker-compose.

APP_NAME=berry-info-bot
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/berry_info_bot
ADMIN_USER_IDS=123456789
# Debug command access policy: disabled | admins | public
DEBUG_COMMANDS_MODE=admins
