APP_NAME=berry-info-bot
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/berry_info_bot
ADMIN_USER_IDS=123456789
# Debug command access policy: disabled | admins | public
DEBUG_COMMANDS_MODE=admins

# OpenAI KB vector store sync/search
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
# Optional overrides (defaults in code are max_results=3, score_threshold=0.7)
OPENAI_KB_SEARCH_MAX_RESULTS=3
OPENAI_KB_SCORE_THRESHOLD=0.7

# Query policy / optional LLM fallback for interpretation only
KB_QUERY_LLM_MODE=disabled
KB_QUERY_LLM_ALLOWED_FOR=classifier,scope,planner,retrieval
KB_QUERY_RULES_MIN_CONFIDENCE=0.85
KB_QUERY_ENABLE_STAGE_RULES=true
KB_QUERY_ENABLE_STAGE_SCOPE=true
KB_QUERY_ENABLE_STAGE_PLANNER=true
KB_QUERY_ENABLE_STAGE_RETRIEVAL=true
KB_QUERY_ENABLE_STAGE_RENDERER=true
# Set when enabling LLM fallback, for example: gpt-5.4-nano
KB_QUERY_LLM_MODEL=
KB_QUERY_LLM_TIMEOUT_SECONDS=10
KB_QUERY_LLM_CACHE_SIZE=128
KB_QUERY_LLM_MAX_RETRIEVAL_VARIANTS=1
