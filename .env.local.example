APP_NAME=berry-info-bot
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=replace_with_real_bot_token
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/berry_info_bot
ADMIN_USER_IDS=123456789

# Reserved for future webhook migration (unused in Phase 1)
WEBHOOK_SECRET_PATH=/telegram/webhook/secret

# Reserved placeholders for future Google integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_API_KEY=

# OpenAI KB vector store sync/search
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
# Optional overrides (defaults in code are max_results=3, score_threshold=0.7)
OPENAI_KB_SEARCH_MAX_RESULTS=3
OPENAI_KB_SCORE_THRESHOLD=0.7
